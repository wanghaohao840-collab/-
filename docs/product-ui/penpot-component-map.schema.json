{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhiyan.local/schemas/penpot-component-map.schema.json",
  "title": "Zhiyan Penpot component map",
  "type": "object",
  "additionalProperties": false,
  "required": ["fileUrl", "components"],
  "properties": {
    "fileUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://design\\.penpot\\.app/(?!.*(?:userToken|figma\\.com)).+$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "penpotId",
        "penpotName",
        "codeFile",
        "exportName",
        "variants",
        "verified"
      ],
      "properties": {
        "penpotId": { "type": "string", "minLength": 1 },
        "penpotName": { "type": "string", "minLength": 1 },
        "codeFile": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\).+$"
        },
        "exportName": { "type": "string", "minLength": 1 },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "verified": { "const": true }
      }
    }
  }
}
